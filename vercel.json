{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "order.kumtsu.com" }],
      "destination": "https://www.kumtsu.com/order/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/internal/login", "destination": "/internal/login.html" },
    { "source": "/internal/forgot-password", "destination": "/internal/forgot-password.html" },
    { "source": "/internal/reset-password", "destination": "/internal/reset-password.html" },
    { "source": "/internal/profile", "destination": "/internal/profile.html" },
    { "source": "/internal/dashboard", "destination": "/internal/dashboard.html" },
    { "source": "/internal/rating-feedback", "destination": "/internal/rating-feedback.html" },
    { "source": "/internal/admin", "destination": "/internal/admin/index.html" },
    { "source": "/internal/admin/", "destination": "/internal/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/internal/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
